@import 'ui/index'


.pdp
    color #666

    &__breadcrumb
        padding 1em
        margin 1em 0

    .product
        &__name
            font-family 'MavenPro Regular'
            text-transform uppercase
            font-size 20px
            letter-spacing 0.1em
            margin-bottom 30px
            color #444

        &__image
            height 100vw
            width 100%
            background-color #efefef
            display flex
            justify-content center
            align-items center

            img
                object-fit contain
                width 100%
                height 70%

        &__detail
            line-height 26px
            font-size 14px
            font-family 'Raleway'
            width 100%
            padding 1em

            &__description
                margin-bottom 20px
                text-align justify

            &__categories
                display grid

                &__extend
                    grid-template-columns repeat(2, 1fr)

    &__applications
        padding 1em
        font-family 'Raleway'

        &__title
            text-align center
            font-size 20px
            text-transform uppercase
            margin-bottom 2em

        &__list
            display grid

            .title
                text-transform uppercase
                color #666
                font-weight bold
                margin-bottom 10px

            .description
                color red


@media screen and (min-width 1024px)
    .pdp
        padding 0 150px

        &__breadcrumb
            padding 1em 0

        .product
            display grid
            grid-template-columns repeat(2, 1fr)
            margin-bottom 50px

            &__name
                font-size 30px

            &__image
                height calc(1290px / 2)
                width 100%
                background-color #efefef
                display flex
                justify-content center
                align-items center

                img
                    object-fit contain

            &__detail
                padding 0
                padding-left 3em

                &__categories
                    &__extend
                        grid-template-columns repeat(3, 1fr)

        &__applications
            border 1px solid #ebebeb

            &__title
                font-size 20px
                font-weight bold

            &__list
                grid-template-columns repeat(2, 1fr)
                gap 2em .5em

                .title
                    margin-bottom 5px

                .description
                    color #444
