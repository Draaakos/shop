@import 'ui/index'


.product
    &__image
        height 100vw
        width 100%
        background-color #efefef
        display flex
        justify-content center
        align-items center

        img
            object-fit cover

    &__description
        width 100%
        padding 1em


@media screen and (min-width 1024px)
    .product
        display grid
        grid-template-columns repeat(2, 1fr)

        &__image
            height calc(1290px / 2)
            width 100%
            background-color #efefef
            display flex
            justify-content center
            align-items center

            img
                object-fit cover

        &__description
            padding 0 1em

