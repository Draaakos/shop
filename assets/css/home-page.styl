@import 'ui/index'


.card__section
    display grid
    gap 2.5em
    margin 1em auto
    padding 1em


.publication__section
    .publication
        padding 1em


.publication__button
    width 100%
    display flex
    justify-content center
    align-items center

    &__item
        border 1px solid #424242
        color #333
        font-family "Raleway Medium", sans-serif
        padding 1em 1.5em
        font-weight 500
        letter-spacing 2px
        text-transform uppercase
        font-size 10px
        margin 2em 0
        opacity .8
        transition background-color .2s ease

        &:hover
            cursor pointer
            opacity 1
            background-color #424242
            color white
            transition background-color .2s ease


.card__section,
.publication__section
    max-width 900px
    // margin 3em auto
    margin -1em auto

.footer__section
    max-width 1280px
    margin 0 auto



@media screen and (min-width 1024px)
    .banner
        .background-img
            margin-bottom 0
            height auto

    .card__section
        grid-template-columns repeat(3, 1fr)
